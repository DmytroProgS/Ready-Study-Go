rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Paste ONLY this match block inside your existing match /databases/{database}/documents.
    // Keep your current /users rules unchanged.
    match /duelRooms/{roomCode} {
      function signedIn() {
        return request.auth != null;
      }
      function uid() {
        return request.auth.uid;
      }
      function member() {
        return signedIn() && uid() in resource.data.players.keys();
      }
      function sameBase() {
        return request.resource.data.host == resource.data.host
          && request.resource.data.players == resource.data.players;
      }
      function changedOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }
      function bothAnswered() {
        return resource.data.players.size() == 2
          && resource.data.answers.keys().hasAll(resource.data.players.keys());
      }
      function joinAsGuest() {
        return signedIn()
          && resource.data.status == 'lobby'
          && resource.data.players.size() == 1
          && !(uid() in resource.data.players.keys())
          && request.resource.data.players.size() == 2
          && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([uid()])
          && request.resource.data.players[uid()] is string
          && request.resource.data.players[uid()].size() > 0
          && request.resource.data.players[uid()].size() <= 24
          && changedOnly(['players']);
      }
      function startByHost() {
        return member()
          && uid() == resource.data.host
          && resource.data.status == 'lobby'
          && resource.data.players.size() == 2
          && request.resource.data.status == 'playing'
          && request.resource.data.index == 0
          && request.resource.data.answers == {}
          && request.resource.data.ready == {}
          && sameBase()
          && changedOnly(['status', 'index', 'answers', 'ready']);
      }
      function answerOnce() {
        return member()
          && resource.data.status == 'playing'
          && resource.data.index < 20
          && !(uid() in resource.data.answers.keys())
          && request.resource.data.answers.diff(resource.data.answers).affectedKeys().hasOnly([uid()])
          && request.resource.data.answers[uid()] is int
          && request.resource.data.answers[uid()] >= 0
          && request.resource.data.answers[uid()] <= 3
          && sameBase()
          && changedOnly(['answers']);
      }
      function readyOnce() {
        return member()
          && resource.data.status == 'playing'
          && bothAnswered()
          && !(uid() in resource.data.ready.keys())
          && request.resource.data.ready.diff(resource.data.ready).affectedKeys().hasOnly([uid()])
          && request.resource.data.ready[uid()] == true
          && sameBase()
          && changedOnly(['ready']);
      }
      function advanceTogether() {
        return member()
          && resource.data.status == 'playing'
          && bothAnswered()
          && !(uid() in resource.data.ready.keys())
          && resource.data.ready.size() == 1
          && resource.data.ready.keys().hasOnly(resource.data.players.keys())
          && resource.data.ready.values().hasOnly([true])
          && request.resource.data.index == resource.data.index + 1
          && request.resource.data.status == (resource.data.index == 19 ? 'finished' : 'playing')
          && request.resource.data.answers == {}
          && request.resource.data.ready == {}
          && request.resource.data.get('history', []).size() == resource.data.get('history', []).size() + 1
          && request.resource.data.history.size() == resource.data.index + 1
          && request.resource.data.history[resource.data.index].answers == resource.data.answers
          && request.resource.data.history == resource.data.get('history', []) + [{'answers': resource.data.answers}]
          && sameBase()
          && changedOnly(['history', 'index', 'status', 'answers', 'ready']);
      }

      allow create: if signedIn()
        && roomCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['host', 'players', 'status', 'index', 'answers', 'ready', 'createdAt'])
        && request.resource.data.host == uid()
        && request.resource.data.players.keys().hasOnly([uid()])
        && request.resource.data.players.size() == 1
        && request.resource.data.players[uid()] is string
        && request.resource.data.players[uid()].size() > 0
        && request.resource.data.players[uid()].size() <= 24
        && request.resource.data.status == 'lobby'
        && request.resource.data.index == 0
        && request.resource.data.answers == {}
        && request.resource.data.ready == {}
        && request.resource.data.createdAt == request.time;

      // A signed-in player with the six-character code may read this room.
      // No collection listing. For a public release, use a backend for room joining.
      allow get: if signedIn();
      allow list, delete: if false;
      allow update: if joinAsGuest() || startByHost() || answerOnce()
        || readyOnce() || advanceTogether();
    }
  }
}
